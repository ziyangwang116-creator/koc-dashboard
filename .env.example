# YouTube Data API v3 key. Keep the real key in your local environment only.
YOUTUBE_API_KEY=
# Optional PostgreSQL/Supabase connection. Leave empty to use data/koc.db.
DATABASE_URL=
# Shared password for team access. Leave empty only for local development.
TEAM_PASSWORD=
# TikTok uses a local persistent Chromium profile at data/tiktok_browser_data.
# Keep this false so that login and verification can be completed manually.
TIKTOK_PERSISTENT_HEADLESS=false
