# Local development values for `docker compose up`. Copy to `.env` and fill in
# as needed — every value below is a placeholder, not a real credential.
#
#   cp deployment/.env.example deployment/.env

# Optional PostgreSQL/Supabase connection string. Leave empty to fall back to
# the bundled sqlite database (data/koc.db) inside the api container's volume.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Shared password gate for the frontend/API session login.
TEAM_PASSWORD=changeme

# Optional: YouTube Data API v3 key, only needed for follower-sync features.
YOUTUBE_API_KEY=

# AI provider config (out of scope for this phase; left for completeness).
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Host port the frontend container is published on.
FRONTEND_PORT=3000
