# Multi-stage Dockerfile for the Next.js frontend (frontend/).
# Build context should be the `frontend/` directory:
#   docker build -f deployment/Dockerfile.frontend -t koc-frontend frontend

FROM node:22-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# API_PROXY_TARGET is read at request time by next.config.ts rewrites(), so it
# does not need to be baked in at build time.
RUN npm run build

FROM node:22-slim AS runner
ENV NODE_ENV=production \
    PORT=3000
WORKDIR /app

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin nextjs

# Next.js standalone output keeps the runtime image minimal; falls back to a
# full copy if standalone output isn't enabled in next.config.ts.
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/next.config.ts ./next.config.ts

RUN chown -R nextjs:nextjs /app
USER nextjs

EXPOSE 3000
CMD ["npm", "run", "start", "--", "-p", "3000"]
