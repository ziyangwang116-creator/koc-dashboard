# Production values. Copy to `.env.production` and fill in with real secrets
# from your own secret manager — every value below is a placeholder.
#
#   cp deployment/.env.production.example deployment/.env.production
#   docker compose --env-file deployment/.env.production up --build -d

# Required in production: a real PostgreSQL/Supabase connection string.
# Never use the sqlite fallback for a multi-user production deployment.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required: a strong shared password (or switch the app to per-user auth
# before exposing it publicly).
TEAM_PASSWORD=changeme

# Optional integrations — leave blank to disable the corresponding feature.
YOUTUBE_API_KEY=
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional Agent Git/deployment automation. Keep disabled until the runtime
# has a writable Git checkout and scoped push credentials.
AGENT_GIT_ENABLED=false
AGENT_GIT_ALLOWED_BRANCHES=main
AGENT_GIT_BRANCH=main
# Railway/cloud mode: use a fine-grained GitHub token limited to this one
# repository, with Contents read/write permission. Never expose it to the UI.
AGENT_GITHUB_REPOSITORY=owner/koc-dashboard
AGENT_GITHUB_TOKEN=
# Optional Railway deploy hook. Leave blank when Railway auto-deploys after
# a successful push to main.
AGENT_DEPLOY_HOOK_URL=

# Host port the frontend container is published on. Put a TLS-terminating
# load balancer or reverse proxy of your choice in front of this port.
FRONTEND_PORT=3000
