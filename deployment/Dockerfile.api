# Production Dockerfile for the FastAPI backend (api/main.py: app).
FROM python:3.12-slim AS base

# Keep Python output unbuffered and avoid writing .pyc files in the image.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install only the OS packages needed to build psycopg[binary] wheels; binary
# wheel already bundles libpq, so no extra runtime libs are required.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies first for better layer caching.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir "gunicorn>=22.0,<23.0"

# Copy the application source.
COPY api ./api
COPY config ./config
COPY core ./core
COPY database ./database
COPY exporters ./exporters
COPY followers ./followers
COPY models ./models
COPY services ./services
COPY ui ./ui

# Create an unprivileged user and hand over ownership of the app directory
# (and a writable data dir for the sqlite fallback / local caches).
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin appuser \
    && mkdir -p /app/data \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# gunicorn manages a small pool of uvicorn workers for production use.
CMD ["gunicorn", "api.main:app", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--workers", "2", \
     "--bind", "0.0.0.0:8000", \
     "--timeout", "60"]
